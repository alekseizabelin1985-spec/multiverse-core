# .mcp.env.example — переменные MCP-серверов IDE (НЕ платформа multiverse-core).
# Скопировать в .mcp.env (файл в .gitignore) и заполнить. Значения — пустые.
# Платформенные переменные MV_* живут в .env / .env.example.

# Personal access token GitHub для MCP-сервера github.
# Где взять: https://github.com/settings/tokens (fine-grained, только чтение нужных репозиториев).
GITHUB_TOKEN=

# Токен MCP-сервера базы данных.
# Где взять: у администратора соответствующего MCP-сервера.
DB_MCP_TOKEN=
