# =============================================================================
# build/versions.env — the single source of truth for pinned versions (NFR-071)
# =============================================================================
# Read by:
#   * docker-compose.yml — through ${...} interpolation
#     (COMPOSE_ENV_FILES=.env,build/versions.env; see .env.example);
#   * Makefile           — `include build/versions.env`;
#   * tests              — shared/testkit.Versions() (F-5t / T-014);
#   * CI                 — `cat build/versions.env >> "$GITHUB_ENV"`.
#
# Source of truth for the values: Docs/dev-team/architecture/infrastructure.md
# v0.3 §2.4 (checked 2026-09-09). Rules:
#   * no `latest` and no floating tags anywhere;
#   * machine specific paths (D:\Models\..., llama-server.exe) never land here —
#     this file is in Git and shared by every environment; they live in .env as
#     MV_LLM_BIN / MV_LLM_MODELS_DIR / ... (infrastructure.md §4.2);
#   * no secrets;
#   * no inline comments after a value: `make include` keeps the trailing
#     whitespace and the dotenv parsers of compose disagree about them.
# Bumping a pin is a separate task with a run of the golden set (ADR-021 §4,
# infrastructure.md §9.5); Dependabot (ecosystem docker, directory build/) does
# not see this file, so the operator compares it with the registries monthly.
# =============================================================================

# --- Go toolchain (ADR-001 add. 1; must stay equal to `toolchain` in go.mod) ---
GO_VERSION=1.26.8

# --- Event bus ---
REDPANDA_IMAGE=docker.redpanda.com/redpandadata/redpanda:v26.1.17
# Redpanda Console — profile `dev` only (T-008, SEC-33).
REDPANDA_CONSOLE_IMAGE=docker.redpanda.com/redpandadata/console:v3.11.0

# --- Object store: built from source, ADR-021 variant B ---
# Upstream minio/minio stopped publishing community images in Oct 2025 and the
# repository was archived in Feb 2026; this tag carries the CVE-2025-62506 fix
# and is the last one published as source.
MINIO_TAG=RELEASE.2025-10-15T17-29-55Z
# MINIO_REPO: infrastructure.md v0.3 §2.5 asks for the owner's fork
# (https://github.com/alekseizabelin1985-spec/minio.git) as the first line of
# defence against the sources disappearing. The fork does not exist yet — only
# the owner can create it (agents do not change external systems), so T-004
# runs on the upstream fallback value. Open question in dev-log.md (T-004);
# switching the value is a one line change once the fork is pushed.
MINIO_REPO=https://github.com/minio/minio.git
MINIO_IMAGE=multiverse-core/minio:RELEASE.2025-10-15T17-29-55Z
# First attempt is the platform toolchain; if the archived sources stop building
# with it, fall back to golang:1.24.x-bookworm (go.mod of the MinIO tag) and
# record the choice here and in dev-log.md (ADR-021 variant B).
MINIO_BUILDER_IMAGE=golang:1.26.8-bookworm
# `mc` runs in the init container only, never in the platform runtime (ADR-021
# §1); if the image disappears, minio-init is replaced by `mvctl storage init`.
MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z

# --- Memory profile (T-008) ---
QDRANT_IMAGE=qdrant/qdrant:v1.19.1
NEO4J_IMAGE=neo4j:5.26.30-community

# --- Optional container runtime for Ollama (profile `gpu`) ---
# Needed only with MV_LLM_PROVIDER=ollama or for embeddings (ADR-005 add. 2 §8).
OLLAMA_IMAGE=ollama/ollama:0.33.3

# --- Legacy profile only (D-3) ---
# The as-is semantic-memory is built with the `chroma_v2_enabled` tag and talks
# to the v2 Chroma API, while the untagged build talks to /api/v1 — which server
# tag actually serves the frozen client is decided on the stand when the profile
# is raised (T-008 owns the `legacy` profile). Left empty on purpose: an empty
# image fails loudly, a guessed tag fails silently.
CHROMA_IMAGE=

# --- LLM runtime outside compose: project-wide pins (machine independent) ---
# llama.cpp build number of the llama-server installed on the owner's machine:
# `llama-server --version` -> "version: 0.1.0-dev (build 10441, commit 0177dcc73)".
# Upgrading the build is a separate task with a golden-set run (§12).
LLAMACPP_BUILD=b10441
# Name (stem) of the default model, variant E — not a path; equals `model` in
# blueprints. The .gguf file itself is pointed at by MV_LLM_MODEL_FILE in .env.
LLM_MODEL_DEFAULT=Qwen3.8-27B-UD-Q3_K_XL

# --- Developer tooling (CI installs exactly these) ---
GOLANGCI_LINT_VERSION=v2.13.2
GITLEAKS_VERSION=v8.30.1
MINIO_COMMIT=9e49d5e7a648
