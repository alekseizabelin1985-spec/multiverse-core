{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiverse-core.io/schemas/events/entity.update.proposed.v1.json",
  "title": "entity.update.proposed payload",
  "description": "A proposal to change entities (contracts.md C-02 v1.2, api-contracts.md 2.3.4). cause=forget carries the single transition alive -> abandoned and is published by the gateway only.",
  "type": "object",
  "properties": {
    "proposal_id": { "type": "string", "minLength": 1 },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "entity": { "$ref": "_common.json#/$defs/EntityWithName" },
          "expected_version": {
            "type": "integer",
            "minimum": 0,
            "description": "Mandatory for hp, status, inventory and the position of a player or NPC in combat (ADR-013 p. 1); State rejects a missing one with version_conflict."
          },
          "ops": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "op": { "type": "string", "enum": ["set", "inc", "append", "remove"] },
                "path": { "type": "string", "minLength": 1 },
                "value": true
              },
              "required": ["op", "path"],
              "additionalProperties": false
            }
          }
        },
        "required": ["entity", "ops"],
        "additionalProperties": false
      }
    },
    "atomic": { "type": "boolean" },
    "cause": {
      "type": "string",
      "description": "Union of api-contracts.md 2.3.4 and the Causes column of state-and-mechanics.md 4.6: every cause a row of contracts.OwnershipRules allows must be publishable.",
      "enum": ["combat", "rest", "move", "loot", "spawn", "tick", "group", "create", "bootstrap", "forget",
               "leave", "flee", "death", "resolve", "init", "author"]
    }
  },
  "required": ["proposal_id", "changes", "atomic", "cause"],
  "additionalProperties": false
}
