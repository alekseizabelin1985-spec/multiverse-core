{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiverse-core.io/schemas/events/narrative.output.v1.json",
  "title": "narrative.output payload",
  "description": "The text a personal GM (solo) or the group narrator (group) produced for the players of a scope (api-contracts.md 2.3.11, contracts.md C-05 v1.1). One event per solo turn and per group round; the text on the bus is the only copy the gateway delivers, and it carries no markup that would need a parse_mode (SEC-10).",
  "type": "object",
  "properties": {
    "recipients": {
      "type": "array",
      "minItems": 1,
      "description": "Every player of the scope, idle ones included.",
      "items": { "$ref": "_common.json#/$defs/EntityWithName" }
    },
    "text": { "type": "string", "minLength": 1 },
    "generated_by": { "type": "string", "enum": ["llm", "template"] },
    "fallback_reason": {
      "type": ["string", "null"],
      "description": "Why the template replaced the model: timeout, unavailable, invalid_after_retries, budget, filter_error, language."
    },
    "kind": { "type": "string", "enum": ["turn", "round", "world_event", "entry", "death"] },
    "round": {
      "type": "object",
      "properties": { "seq": { "type": "integer", "minimum": 1 } },
      "required": ["seq"],
      "additionalProperties": false
    },
    "llm_output": {
      "type": "object",
      "properties": {
        "event": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "type": { "type": "string", "minLength": 1 }
          },
          "required": ["id"],
          "additionalProperties": false
        }
      },
      "required": ["event"],
      "additionalProperties": false
    },
    "based_on": {
      "type": "array",
      "description": "The domain events the text tells about, first of all combat.decided.",
      "items": {
        "type": "object",
        "properties": {
          "event": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 }
            },
            "required": ["id"],
            "additionalProperties": false
          }
        },
        "required": ["event"],
        "additionalProperties": false
      }
    },
    "absence": {
      "type": "object",
      "description": "The while-you-were-away summary of an entry narrative (metrics.md 4.2).",
      "properties": {
        "since_at": { "$ref": "_common.json#/$defs/Timestamp" },
        "background_events_count": { "type": "integer", "minimum": 0 }
      },
      "required": ["since_at", "background_events_count"],
      "additionalProperties": false
    },
    "background_refs": {
      "type": "array",
      "description": "Background events of the region the text actually surfaced; the gateway copies their ids into analytics.turn.completed.absence.surfaced_event_ids.",
      "items": {
        "type": "object",
        "properties": {
          "event": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 }
            },
            "required": ["id"],
            "additionalProperties": false
          }
        },
        "required": ["event"],
        "additionalProperties": false
      }
    },
    "filter": {
      "type": "object",
      "properties": {
        "applied": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pass", "block", "error"] },
        "filter_version": { "type": "string", "minLength": 1 }
      },
      "required": ["applied", "status", "filter_version"],
      "additionalProperties": false
    },
    "locale": { "type": "string", "minLength": 1 },
    "laws_version": { "type": "string", "minLength": 1 },
    "narrative_event_id": {
      "type": "string",
      "minLength": 1,
      "description": "Optional (C-05 v1.1): a copy of the id of this event, shared by every recipient of a group round, so that the gateway need not read the envelope to group deliveries."
    }
  },
  "required": ["recipients", "text", "generated_by", "kind", "locale", "laws_version"],
  "additionalProperties": false
}
