{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiverse-core.io/schemas/events/analytics.session.started.v1.json",
  "title": "analytics.session.started payload",
  "description": "A play session of a scope began (metrics.md 4.2, contracts.md C-10). Analytics carry no free text and no external identifier, and they are never read during a replay. world and scope are optional here: the envelope is the source of truth, the copy is a convenience of the CSV pipeline.",
  "type": "object",
  "properties": {
    "world": { "$ref": "_common.json#/$defs/WorldRef" },
    "scope": { "$ref": "_common.json#/$defs/ScopeRef" },
    "session": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "scope.id and the unix time of the start, joined by a colon." },
        "kind": { "type": "string", "enum": ["solo", "group"] },
        "actor_kind": { "type": "string", "enum": ["human", "ci", "sim"] },
        "started_at": { "$ref": "_common.json#/$defs/Timestamp" },
        "players_count": { "type": "integer", "minimum": 1 }
      },
      "required": ["id", "kind", "actor_kind", "started_at", "players_count"],
      "additionalProperties": false
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "_common.json#/$defs/EntityWithName" }
    }
  },
  "required": ["session", "participants"],
  "additionalProperties": false
}
