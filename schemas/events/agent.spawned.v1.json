{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiverse-core.io/schemas/events/agent.spawned.v1.json",
  "title": "agent.spawned payload",
  "description": "The swarm runtime spawned an agent (api-contracts.md 2.3.9). parent is absent for the root agent of a world; content_hash of the blueprint is optional (contracts.md C-07 v1.1) and lets an operator tell two runs of the same version apart.",
  "type": "object",
  "properties": {
    "agent": { "$ref": "_common.json#/$defs/AgentRef" },
    "parent": {
      "type": "object",
      "properties": { "id": { "type": "string", "minLength": 1 } },
      "required": ["id"],
      "additionalProperties": false
    },
    "scope": { "$ref": "_common.json#/$defs/ScopeRef" },
    "ttl_expires_at": { "$ref": "_common.json#/$defs/Timestamp" },
    "lod": { "type": "string", "enum": ["disabled", "rule-only", "basic", "full"] },
    "content_hash": { "type": "string", "minLength": 1 }
  },
  "required": ["agent"],
  "additionalProperties": false
}
