{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiverse-core.io/schemas/events/world.law_breach.proposed.v1.json",
  "title": "world.law_breach.proposed payload",
  "description": "A proposal to break a law of the world (api-contracts.md 2.3.13, ADR-008). Reserved in MVP-1: the schema is registered and valid, the publisher arrives with E-B (contracts.md C-12).",
  "type": "object",
  "properties": {
    "breach": {
      "type": "object",
      "properties": { "id": { "type": "string", "minLength": 1 } },
      "required": ["id"],
      "additionalProperties": false
    },
    "initiator": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["agent", "author", "player_indirect"] },
        "agent": { "$ref": "_common.json#/$defs/AgentRef" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "cause_event_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "strain": { "type": "number", "minimum": 0 },
    "laws_removed": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "laws_added": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "canon_invalidated": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "narrative_hook": { "type": "string" },
    "laws_version_base": { "type": "string", "minLength": 1 }
  },
  "required": ["breach", "initiator", "cause_event_ids", "strain", "laws_version_base"],
  "additionalProperties": false
}
