{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiverse-core.io/schemas/events/world.law_breach.review_decided.v1.json",
  "title": "world.law_breach.review_decided payload",
  "description": "The review of an applied breach ended (api-contracts.md 2.3.13). reviewer_kind=timeout is the decision of G1: an expired window approves. Reserved in MVP-1, publisher E-B.",
  "type": "object",
  "properties": {
    "breach": {
      "type": "object",
      "properties": { "id": { "type": "string", "minLength": 1 } },
      "required": ["id"],
      "additionalProperties": false
    },
    "decision": { "type": "string", "enum": ["approved", "rolled_back"] },
    "reviewer_kind": { "type": "string", "enum": ["human", "timeout"] },
    "decided_at": { "$ref": "_common.json#/$defs/Timestamp" }
  },
  "required": ["breach", "decision", "reviewer_kind", "decided_at"],
  "additionalProperties": false
}
