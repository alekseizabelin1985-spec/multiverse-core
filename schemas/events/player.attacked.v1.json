{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiverse-core.io/schemas/events/player.attacked.v1.json",
  "title": "player.attacked payload",
  "description": "A player attacked a target inside an encounter round (api-contracts.md 2.3.1).",
  "type": "object",
  "properties": {
    "entity": { "$ref": "_common.json#/$defs/EntityWithName" },
    "action": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "key_hash": { "type": "string" }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "target": { "$ref": "_common.json#/$defs/EntityWithName" },
    "encounter": { "$ref": "_common.json#/$defs/EntityWithName" },
    "round": {
      "type": "object",
      "properties": { "seq": { "type": "integer", "minimum": 1 } },
      "required": ["seq"],
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "properties": { "id": { "type": "string", "minLength": 1 } },
      "required": ["id"],
      "additionalProperties": false
    }
  },
  "required": ["entity", "action", "target"],
  "additionalProperties": false
}
