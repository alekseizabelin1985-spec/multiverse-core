{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiverse-core.io/schemas/events/analytics.session.ended.v1.json",
  "title": "analytics.session.ended payload",
  "description": "A play session ended (metrics.md 4.2, contracts.md C-10 v1.1). end_reason=forget closes a session the /forget cascade tore down (FR-061); it is not an error and does not count towards the S-metrics.",
  "type": "object",
  "properties": {
    "world": { "$ref": "_common.json#/$defs/WorldRef" },
    "scope": { "$ref": "_common.json#/$defs/ScopeRef" },
    "session": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["solo", "group"] },
        "actor_kind": { "type": "string", "enum": ["human", "ci", "sim"] },
        "started_at": { "$ref": "_common.json#/$defs/Timestamp" },
        "ended_at": { "$ref": "_common.json#/$defs/Timestamp" },
        "end_reason": { "type": "string", "enum": ["leave", "idle", "death", "error", "forget"] },
        "players_count": { "type": "integer", "minimum": 1 },
        "turns_count": { "type": "integer", "minimum": 0 },
        "turns_degraded": { "type": "integer", "minimum": 0 },
        "turns_failed": { "type": "integer", "minimum": 0 }
      },
      "required": ["id", "kind", "actor_kind", "started_at", "ended_at", "end_reason",
                   "players_count", "turns_count", "turns_degraded", "turns_failed"],
      "additionalProperties": false
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "_common.json#/$defs/EntityWithName" }
    }
  },
  "required": ["session", "participants"],
  "additionalProperties": false
}
