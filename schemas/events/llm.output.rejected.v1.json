{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiverse-core.io/schemas/events/llm.output.rejected.v1.json",
  "title": "llm.output.rejected payload",
  "description": "One reason an answer of the LLM was refused (api-contracts.md 2.3.10, ADR-017 p. 3). One event per dropped element; without element the whole answer was refused. With reason=budget_exceeded there was no call at all, so llm_output is absent and budget says which limit stopped it; with any other reason there was a call, so llm_output is present and budget is not (contracts.md C-07 v1.3).",
  "type": "object",
  "properties": {
    "llm_output": {
      "type": "object",
      "properties": {
        "event": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "type": { "type": "string", "minLength": 1 }
          },
          "required": ["id"],
          "additionalProperties": false
        }
      },
      "required": ["event"],
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "enum": ["unknown_entity", "player_agency", "level_violation", "schema_invalid", "language",
               "filter_blocked", "filter_error", "budget_exceeded", "law_violation", "other"]
    },
    "element": {
      "type": "object",
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "type": { "type": "string", "minLength": 1 }
      },
      "required": ["index"],
      "additionalProperties": false
    },
    "entity": { "$ref": "_common.json#/$defs/EntityWithName" },
    "background_ref": {
      "$ref": "_common.json#/$defs/EventRef",
      "description": "The background event an unknown reference of the answer pointed at (C-07 v1.3). Rule 3 of the guardian drops background_refs[] too, and those are event ids: naming them through entity would make the publisher invent the type of an entity that does not exist."
    },
    "category": { "type": "string", "enum": ["a"] },
    "budget": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["background", "turn", "cloud"] },
        "limit": { "type": "integer", "minimum": 0 },
        "window": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "limit", "window"],
      "additionalProperties": false
    },
    "phase": { "type": "string", "enum": ["decision", "narrative", "tick", "other"] },
    "attempt": { "type": "integer", "minimum": 1 }
  },
  "required": ["reason", "phase", "attempt"],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "budget_exceeded is refused before any call: there is a budget to name and no record to point at. Every other reason refuses an answer, so it points at the record of that answer and names no budget.",
      "if": {
        "properties": { "reason": { "const": "budget_exceeded" } },
        "required": ["reason"]
      },
      "then": {
        "required": ["budget"],
        "not": { "required": ["llm_output"] }
      },
      "else": {
        "required": ["llm_output"],
        "not": { "required": ["budget"] }
      }
    },
    {
      "$comment": "An unknown reference is always a dropped element, and it is either an entity or a background event — exactly one of the two.",
      "if": {
        "properties": { "reason": { "const": "unknown_entity" } },
        "required": ["reason"]
      },
      "then": {
        "required": ["element"],
        "oneOf": [
          { "required": ["entity"] },
          { "required": ["background_ref"] }
        ]
      }
    }
  ]
}
