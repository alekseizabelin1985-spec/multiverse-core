# =============================================================================
# Multiverse-Core — пример конфигурации окружения (MVP-1)
# =============================================================================
# Скопировать в .env и заполнить:  cp .env.example .env
# Источник истины: Docs/dev-team/architecture/infrastructure.md v0.3 §4.2.
# Правила (§4.1): все платформенные переменные — с префиксом MV_ и объявлены
# через shared/env.Declare; переменные сторонних образов префикса не имеют.
# Секреты в этом файле всегда ПУСТЫ. Версии образов — только build/versions.env.
#
# ВАЖНО о формате (T-397): у переменной с ПУСТЫМ значением комментарий пишется
# СТРОКОЙ ВЫШЕ, а не после `=`. Парсер dotenv у compose обрезает хвостовой
# комментарий только после непустого значения; после пустого он берёт его ТЕКСТОМ
# ЗНАЧЕНИЯ. Строка `MINIO_ROOT_USER=   # обязательна` давала `MINIO_ROOT_USER`
# длиной в комментарий — непустой, поэтому `${VAR:?}` в compose молчал и MinIO
# стартовал с мусорным логином. `set -a; . ./.env` в Makefile при этом даёт
# пустую строку, то есть compose и make расходились в значении одной переменной.
# Та же причина, по которой инлайн-комментарии запрещены в build/versions.env и
# .github/ci.env. `scripts/compose-lint.sh` (правило 7) это проверяет.
#
# Пометка `[required]` в комментарии = переменную обязан заполнить оператор ДО
# первого `make up` с набором профилей, который задан ниже. Пометка стоит в
# комментарии НАД переменной и является ЕДИНСТВЕННЫМ источником этого списка:
# README намеренно описывает правило («заполнить помеченные»), а не имена, чтобы
# текст не расходился с файлом при следующей правке. Она
# машиночитаемая: `scripts/compose-lint.sh`
# (правило 7) собирает из этого файла «чистую машину» и проверяет, что
# `docker-compose.yml` на ней интерполируется без единой ошибки — именно так
# T-397 закрыл падение `make up` до старта первого контейнера. И обратно: каждая
# переменная, которую `docker-compose.yml` требует через `${VAR:?}`, обязана
# нести здесь пометку `[required]` (правило 7, T-413) — иначе оператор по
# инструкции её пропустит. Переменная,
# которую на чистой машине заполнять НЕ обязаны (токен бота, тег образа Chroma),
# в `docker-compose.yml` появляться не должна — её место в файле профиля.
# =============================================================================

# ===== compose =====
COMPOSE_PROJECT_NAME=multiverse
# `bot` в наборе по умолчанию НЕ стоит: сервиса telegram-bot ещё нет (cmd/ содержит
# только multiverse и mvctl), и `make up` на чистой машине упал бы на сборке.
# Профиль появится вместе с ботом в EPIC-004.
COMPOSE_PROFILES=memory              # набор профилей: memory,gpu,bot,dev,legacy
# Профили `bot` и `legacy` лежат в собственных файлах — docker-compose.bot.yml и
# docker-compose.legacy.yml (T-397): compose интерполирует файл целиком ДО отбора
# по профилям, поэтому обязательные переменные этих сервисов (токен бота,
# CHROMA_IMAGE) в общем файле ломали запуск всем. `make up` подключает нужный
# файл сам, по набору профилей выше или по `make up PROFILES=bot`. Голый
# `docker compose` этих файлов не видит: для профилей `bot` и `legacy` запуск
# идёт через `make`, либо, с `COMPOSE_ENV_FILES` в оболочке (см. ниже), через
# `docker compose -f docker-compose.yml -f docker-compose.bot.yml`.
# Эту строку compose НЕ читает (T-412, проверено на compose v5.2): переменная
# называет env-файлы, поэтому compose берёт её только из окружения своего
# процесса, а не из самого .env. Её экспортирует Makefile — поэтому стек
# поднимается только через `make`; голый `docker compose` без неё не видит
# build/versions.env и падает на первой переменной образа (REDPANDA_IMAGE
# или другой *_IMAGE). Для ручной команды compose
# (exec, logs, restart) задать то же значение в оболочке:
# `export COMPOSE_ENV_FILES=.env,build/versions.env`
# (PowerShell: `$env:COMPOSE_ENV_FILES = ".env,build/versions.env"`).
# Строка остаётся: её объявляет манифест shared/env (mvctl env check).
COMPOSE_ENV_FILES=.env,build/versions.env
MV_IMAGE_TAG=dev                     # тег образа multiverse-core (make deploy подставляет git sha)

# ===== infrastructure (имена диктуют образы) =====
# [required] обязательна; не minioadmin
MINIO_ROOT_USER=
# [required] обязательна, >= 16 символов; секрет
MINIO_ROOT_PASSWORD=
# [required] обязательна при профилях memory/legacy; секрет (compose собирает NEO4J_AUTH=neo4j/${NEO4J_PASSWORD})
NEO4J_PASSWORD=
# --- Ollama: НЕОБЯЗАТЕЛЕН, нужен только при MV_LLM_PROVIDER=ollama (конфигурации C/A, эмбеддинги) ---
# Значения ниже — умолчания манифеста (shared/env/infra.go: настройки §6.4 и
# loopback-origins SEC-15), и compose в профиле gpu подставляет ровно их;
# правило 8 compose-lint сверяет эти два места (T-413). Раскомментировать
# строку нужно, только чтобы задать ДРУГОЕ значение. Нативная Ollama .env не
# читает: ей те же значения задаются переменными окружения ОС.
#OLLAMA_KEEP_ALIVE=-1               # только профиль gpu; нативно — переменные окружения Windows
#OLLAMA_MAX_LOADED_MODELS=2
#OLLAMA_NUM_PARALLEL=1
#OLLAMA_FLASH_ATTENTION=1
#OLLAMA_KV_CACHE_TYPE=f16            # q8_0 — вариант замера с квантованным KV (§6.4)
#OLLAMA_ORIGINS=http://127.0.0.1,http://localhost   # НИКОГДА не `*` (SEC-15); compose-lint проверяет

# ===== platform, общие для всех процессов =====
MV_ENV=dev                           # dev|ci|prod
MV_LOG_LEVEL=info                    # debug|info|warn|error
MV_LOG_FORMAT=json                   # json|text
# РЕЖИМ И ВИД ШИНЫ — ИСТИНА ЗДЕСЬ (T-408). Обе переменные ЧИТАЕТ процесс
# (cmd/multiverse/serve.go): значение отсюда становится умолчанием флагов
# `--mode` и `--bus`, а флаг перекрывает его только тогда, когда его передали
# руками. Compose флагов не передаёт — значит, в контейнерах решают эти строки.
# До T-408 обе переменные объявлялись, передавались в контейнеры и не читались
# НИКЕМ: выбор делали флаги, которых compose не передавал, и `MV_MODE=replay`
# давал рабочий режим молча. Процесс печатает при старте, что и откуда взял:
# `mode: replay (MV_MODE)` либо `mode: live (--mode)`.
MV_MODE=live                         # live|replay
# ВИД ШИНЫ НАЗЫВАЕТСЯ ПО ПРОТОКОЛУ, А НЕ ПО ПРОДУКТУ. Прежнее значение
# `redpanda` ОТМЕНЕНО (T-408): манифест объявлял его, флаг принимал `kafka` —
# два словаря без пересечения. Осталось `kafka`: брокеры и так задаются в
# MV_KAFKA_BROKERS, клиент — кафковый (shared/eventbus/kafka.go), а Redpanda —
# одна из реализаций этого API. `redpanda` НЕ принимается молча: и `mvctl env
# check`, и процесс отказываются с текстом, который называет замену. В .env
# нужно поправить одну строку: MV_BUS=redpanda -> MV_BUS=kafka.
# `memory` — шина в памяти, только вместе с `--contexts=all` (e2e и отладка
# одного процесса); процесс с другим набором контекстов откажется стартовать.
MV_BUS=kafka                         # kafka|memory (kafka = Kafka API, в compose это Redpanda)
MV_BUS_VALIDATE_ON_READ=true         # валидация схемы при чтении (ADR-007 доп. п. 4)
MV_KAFKA_BROKERS=redpanda:9092       # go run на хосте: 127.0.0.1:19092
MV_MINIO_ENDPOINT=minio:9000         # без схемы; на хосте 127.0.0.1:9000
# [required] секрет; для dev = MINIO_ROOT_USER, для prod — отдельный пользователь (mc admin user add)
MV_MINIO_ACCESS_KEY=
# [required] секрет
MV_MINIO_SECRET_KEY=
# true — к объектному хранилищу по https; локальный стек — false
MV_MINIO_USE_SSL=false
MV_WORLD_ID=dark-forest-world        # мир по умолчанию для mvctl и bootstrap
# публичный ключ age для бэкапа links.db (не секрет; §5.6)
MV_BACKUP_AGE_RECIPIENT=

# ===== gateway =====
# MV_GATEWAY_ADDR ОТМЕНЕНА (T-408): один процесс держит один HTTP-сервер, и его
# адрес — MV_CORE_ADDR (см. блок core ниже) при любом наборе `--contexts`.
# Прежняя переменная была объявлена, передавалась в контейнер и не читалась
# никем — compose копировал её значение в MV_CORE_ADDR, а опубликованный порт и
# проверка здоровья оставались литералами, так что «настройка» только ломала
# стенд, если её меняли. Строку из своего .env надо удалить; `mvctl env check
# --env` скажет о ней вслух, а не промолчит.
MV_GATEWAY_DATA_DIR=/data            # links.db, gateway.db (том gateway-data)
# Списки клиентов (эти два и MV_CORE_ADMIN_CLIENTS ниже) compose передаёт КАК
# ЕСТЬ, без собственного умолчания (T-411). Строка есть — решает она, и пустое
# значение означает пустой список, то есть НИКОГО. Строки нет — в контейнер
# переменная не попадает, и действует умолчание манифеста (shared/env/vars.go),
# то же, что у процесса, запущенного руками. До T-411 compose подставлял свои,
# более узкие списки: харнесс CI вне контейнера допускался, а в нём — нет.
# В PROD: все три строки держать ВСЕГДА и убрать ci-harness из всех трёх — без
# строки контейнер получает список манифеста, а ci-harness есть в каждом из них.
MV_GATEWAY_CLIENT_IDS=telegram-bot,ci-harness,mvctl   # allow-list X-Client-Id (ADR-009 п. 9); в prod без ci-harness
MV_GATEWAY_ACTOR_KIND_CLIENTS=ci-harness,mvctl        # кому разрешён X-Actor-Kind ci|sim
MV_CORE_URL=http://core:8090         # прокси /v1/admin/* (D-7)

# ===== core =====
# ЕДИНСТВЕННЫЙ адрес прослушивания процесса, какой бы набор контекстов он ни
# запускал: /health, /v1/admin/* (D-7) и — у процесса с контекстом gateway —
# игровое API. serve.go создаёт ОДИН сервер (shared/runtime) и отдаёт его mux
# всем контекстам, поэтому отдельных адресов у ролей нет (T-408). Внутри compose
# каждый сервис получает свой литерал (:8088 gateway, :8090 core, :8082 memory),
# совпадающий с его опубликованным портом и проверкой здоровья; значение ниже —
# для процесса, который вы запускаете сами на хосте (`go run`, mvctl).
MV_CORE_ADDR=:8090                   # /health и /v1/admin/* (D-7; сервер — shared/runtime)
# compose передаёт как есть, без своего умолчания — см. блок gateway (T-411)
MV_CORE_ADMIN_CLIENTS=operator,mvctl,ci-harness # X-Client-Id, допущенные к /v1/admin/* (ADR-009 п. 9); через запятую (ОВ-28)
MV_MEMORY_URL=http://memory:8082     # пусто = память выключена (деградация FR-035)
MV_SNAPSHOT_EVERY_FACTS=200          # снапшот State каждые N фактов
MV_GM_PATH=agent                     # agent|legacy — фича-флаг миграции GM (S5)
MV_LAWS_BREACH_PHASE=false
MV_LAWS_DIR=laws                     # каталог документов законов <мир>.v<N>.yaml (C-12); относительно рабочего каталога процесса
MV_SWARM_BLUEPRINTS_DIR=blueprints   # каталог блупринтов роя (C-11); относительно рабочего каталога процесса, от него же — ссылки блупринтов
# Временный флаг точки I1-α (T-255): true — контекст swarm процесса поднимается
# заглушкой Phase 1 (бой FakeEncounter + шаблонный нарратив FakeNarrator из
# shared/testkit/swarm) вместо роя. Читает cmd/multiverse, не контекст.
# Мир заглушка узнаёт из фактов entity.created на шине — то есть после
# инициализации мира (mvctl world init, EPIC-002); каталога фикстур у процесса нет.
# Заглушке нужен rules/ в рабочем каталоге процесса; в образе его нет — в
# контейнере с флагом процесс не стартует; в отказе сразу после имени контекста
# стоит MV_SWARM_FAKE=true.
# Удаляется вместе с хуком задачей T-256 (критерий тега mvp-1/i1).
MV_SWARM_FAKE=false                  # true|false; compose флаг в контейнеры не передаёт

# ===== llm (рантайм по умолчанию — нативный llama-server, ADR-005 доп. 2) =====
MV_LLM_PROVIDER=openai_compat        # openai_compat|ollama|anthropic|recorded|fake
# ЕДИНСТВЕННЫЙ источник адреса LLM: и платформа, и scripts/llm-*.{sh,ps1}
# берут адрес отсюда, по одному правилу (scripts/lib/llm-endpoint.sh и .psm1).
# Умолчания у переменной НЕТ (T-404, ревью #2): адрес LLM нельзя угадать, а
# тихое умолчание означало бы, что при удалённой строке платформа считает адрес
# заданным, а make llm-health — нет. Пустое значение и отсутствие строки дают
# один и тот же ненулевой код, а не «проверять нечего».
# Писать можно КАК С ХВОСТОМ /v1, ТАК И БЕЗ — обвязка приводит значение к
# базовому адресу сама и говорит об этом строкой в выводе; править значение
# руками из-за этого не нужно. Проверка здоровья идёт НЕ под /v1.
# Примеры: из контейнеров http://host.docker.internal:8888,
# go run / mvctl на хосте http://127.0.0.1:8888, облако https://api.вендор/v1.
# Порт, который слушает локальный llama-server (--port), и адрес проверок
# make llm-health / make bench выводятся из этого значения; отдельной
# переменной для порта нет, а для локального адреса порт надо указать явно.
# Проверка с хоста подставляет 127.0.0.1 вместо host.docker.internal — это имя
# резолвится только внутри контейнера; любой другой адрес проверяется как есть.
# [required] заполнить до первого `make up`: compose требует её через `:?` (сервис core, T-404)
MV_LLM_URL=
# пусто для локального llama-server; секрет — только для облачного эндпоинта
MV_LLM_API_KEY=
# контекст на слот; --ctx-size llama-server = MV_LLM_NUM_CTX x число слотов
MV_LLM_NUM_CTX=8192
MV_LLM_STORE_PROMPTS=false           # полные промпты в prompts-{world} (ILM 30 дн.)
MV_LLM_CLOUD_ENABLED=false           # гейт по HOST в MV_LLM_URL, не по имени провайдера (ADR-005 доп. 2 п. 3)
MV_LLM_CLOUD_ALLOW_EXTERNAL_PLAYERS=false
MV_LLM_CLOUD_BUDGET_USD_PER_DAY=0
# таймаут одной попытки фазы narrative (длительность Go: 20s, 1500ms)
MV_LLM_TIMEOUT_NARRATIVE=20s
# таймаут одной попытки фазы tick
MV_LLM_TIMEOUT_TICK=30s
# таймаут одной попытки фазы decision; зарезервирована, в MVP-1 не используется
MV_LLM_TIMEOUT_DECISION=5s
# укороченный таймаут попытки, пока провайдер unavailable: восстановление без рестарта
MV_LLM_TIMEOUT_DEGRADED=3s
# таблица цен за 1000 токенов по (endpoint_host, model); относительный путь — от рабочего каталога процесса; локальные адреса стоят 0
MV_LLM_PRICES=config/llm-prices.yaml
# секрет; только для провайдера anthropic (E-H)
MV_ANTHROPIC_API_KEY=

# --- llama-server: локальные пути и параметры запуска (читает только scripts/llm-server.*; в контейнеры не передаются) ---
# Пути Windows заключать в одинарные кавычки: 'D:\Models\llama\llama-server.exe'.
# Makefile загружает .env через `set -a; . ./.env` (§4.3), и без кавычек bash съест обратные слэши.
MV_LLM_BIN=
# single-режим (-m), *.gguf
MV_LLM_MODEL_FILE=
# router-режим (--models-dir, БЕЗ -m); варианты A/E+
MV_LLM_MODELS_DIR=
MV_LLM_SLOT_SAVE_PATH=
# интерфейс, который слушает локальный сервер (НЕ дубликат адреса из
# MV_LLM_URL: «что слушать» и «куда стучаться» — разные вопросы); только
# loopback, наружу не публикуется (SEC-15). Порт берётся из MV_LLM_URL.
# Нелокальное значение = make llm-up ОТКАЗЫВАЕТСЯ запускать сервер: у
# llama-server нет аутентификации, и предупреждение вместо отказа — имитация
# контроля (T-404, решение оркестратора).
MV_LLM_HOST=127.0.0.1
MV_LLM_SLOTS=1                       # --parallel; 1 = как OLLAMA_NUM_PARALLEL=1
MV_LLM_NGL=99                        # --n-gpu-layers
MV_LLM_THREADS=32                    # --threads
MV_LLM_BATCH_SIZE=16000              # --batch-size
MV_LLM_REASONING=off                 # серверный --reasoning on|off|auto; на запрос шлюз шлёт enable_thinking=false

# --- Ollama: только при MV_LLM_PROVIDER=ollama (иначе не заполнять) ---
#MV_OLLAMA_URL=http://host.docker.internal:11434  # профиль gpu: http://ollama:11434; go run: http://127.0.0.1:11434

# ===== mvctl (CLI на хосте; публикует в шину: laws bump, world init, record) =====
# те же MV_* что и у процессов, но с адресами хоста:
#   MV_KAFKA_BROKERS=127.0.0.1:19092   (external listener Redpanda, §1.4)
#   MV_MINIO_ENDPOINT=127.0.0.1:9000
#   MV_LLM_URL=http://127.0.0.1:<порт из блока llm>   (то же значение, но loopback вместо host.docker.internal)
#   MV_CORE_URL=http://127.0.0.1:8090

# ===== memory (профиль memory) =====
# MV_MEMORY_ADDR ОТМЕНЕНА (T-408), по той же причине, что и MV_GATEWAY_ADDR:
# процесс памяти слушает MV_CORE_ADDR, как и любой другой. В compose сервису
# memory проставлен литерал :8082 — тот же порт, что он публикует.
MV_QDRANT_ADDR=qdrant:6334           # gRPC
MV_NEO4J_URI=neo4j://neo4j:7687
MV_NEO4J_USER=neo4j
# [required] секрет; = NEO4J_PASSWORD
MV_NEO4J_PASSWORD=
# модель эмбеддингов сервиса памяти; или bge-m3 — по замеру
MV_EMBED_MODEL=nomic-embed-text

# ===== telegram-bot (профиль bot) =====
# Сервис telegram-bot описан в docker-compose.bot.yml — он подключается только
# при профиле `bot` (T-397). Пустой токен там падает громко и с внятным текстом;
# в общем файле он падал у всех, включая тех, кто бота не поднимает.
# секрет; выдаёт @BotFather; передаётся только сервису telegram-bot
MV_TELEGRAM_BOT_TOKEN=
# allowlist Telegram user id через запятую (SEC-06); пусто = бот никого не пускает
MV_TELEGRAM_ALLOWED_USER_IDS=
MV_TELEGRAM_GATEWAY_URL=http://gateway:8088
MV_TELEGRAM_POLL_TIMEOUT_S=25
MV_TELEGRAM_HEALTH_ADDR=:8089

# ===== legacy (профиль legacy; as-is имена, вне реестра shared/env) =====
# Профиль поднимается только на время миграции GM (MV_GM_PATH=legacy, S5) и
# исчезает вместе с EPIC-003 I2 (D-3). As-is сервисы читают свои имена без
# префикса MV_; всё, что можно, docker-compose.yml берёт из платформенных
# переменных выше (KAFKA_BROKERS, NEO4J_*, MINIO_*), поэтому здесь остаются
# только те, у которых нет платформенного двойника. Пусто = взять дефолт из
# compose. Сервисы профиля описаны в docker-compose.legacy.yml (T-397), файл
# подключается только вместе с профилем. Тег образа Chroma — CHROMA_IMAGE в
# build/versions.env (сейчас пуст намеренно, D-3: решается на стенде, пустое
# значение падает громко — теперь только у того, кто поднимает профиль).
# Профиль собирается не из рабочего дерева, а из коммита LEGACY_SRC_REF
# (build/versions.env): `make legacy-src` перед `make up PROFILES=legacy`.
#LEGACY_ORACLE_URL=http://host.docker.internal:1234/v1/chat/completions
#LEGACY_ORACLE_TIMEOUT_MS=60000
#LEGACY_CHROMA_COLLECTION=multiverse_events
