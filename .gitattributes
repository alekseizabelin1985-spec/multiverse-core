* text=auto
*.go text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
Makefile text eol=lf
*.exe binary
*.pdf binary
testdata/recordings/*.jsonl merge=binary
# The fixture pointer states the size of the snapshot object in bytes (C-14
# v1.1, §4.4), so a consumer that reads the object off a Windows checkout must
# get the same file the pointer describes: CRLF would make it 4686 bytes where
# the pointer says 4531.
testdata/fixtures/** text eol=lf
# The table of the local address (T-450) is read by bash, PowerShell and Go; a
# CRLF checkout would put a CR into the last field of every row for a reader that
# forgets to strip it.
testdata/llm/*.tsv text eol=lf
