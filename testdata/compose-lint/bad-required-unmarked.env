# The example file scripts/compose-lint.sh reads instead of .env.example when it
# lints bad-required-unmarked.yml. Values are placeholders, never credentials.
COMPOSE_PROJECT_NAME=multiverse
MV_IMAGE_TAG=fixture
# the address of the LLM; the marker the README asks for is missing on purpose
MV_LLM_URL=http://host.docker.internal:8888
