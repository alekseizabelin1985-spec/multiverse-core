# =============================================================================
# .github/ci.env — NOT A SECRET FILE
# =============================================================================
# .env.example with dummy values substituted for every ${VAR:?} of the compose
# files, so that `docker compose config` can interpolate them without a real
# .env. Used by the `compose-lint` job and by the local check
# (infrastructure.md §3.1, §3.2):
#
#   docker compose --env-file build/versions.env --env-file .github/ci.env config -q
#
# Two of the values here — MV_TELEGRAM_BOT_TOKEN and CHROMA_IMAGE — no longer
# belong to docker-compose.yml at all: T-397 moved their services into
# docker-compose.bot.yml and docker-compose.legacy.yml, because a required
# variable of a service outside the default set breaks interpolation for
# everybody. They stay here because scripts/compose-lint.sh resolves all three
# files, and rules 1-6 must keep seeing those two services.
#
# Rules for this file:
#   * every value is fake and worthless — nothing here may ever be a credential
#     that works anywhere (gitleaks scans this path like any other);
#   * no inline comments after a value: the dotenv parsers of compose and make
#     disagree about them;
#   * COMPOSE_ENV_FILES is deliberately absent — the files are passed on the
#     command line here, as the Makefile passes them through that variable for
#     day to day runs; a line in an env file would be inert anyway, compose
#     reads it from the process environment only (T-412);
#   * image pins are not repeated: they come from build/versions.env, which is
#     passed as the first --env-file.
# Keep in sync with .env.example when a variable is added (mvctl env check,
# T-010, compares .env.example with the shared/env registry, not this file).
# =============================================================================

# ===== compose =====
COMPOSE_PROJECT_NAME=multiverse
# Empty on purpose: the core (no profile) is the default check; the profile
# checks of T-008 pass --profile explicitly.
COMPOSE_PROFILES=
MV_IMAGE_TAG=ci

# ===== infrastructure (names dictated by the images) =====
MINIO_ROOT_USER=ci-only-not-a-secret
MINIO_ROOT_PASSWORD=ci-only-not-a-secret-0000
NEO4J_PASSWORD=ci-only-not-a-secret

# ===== platform =====
MV_ENV=ci
MV_LOG_LEVEL=info
MV_LOG_FORMAT=json
MV_MODE=live
MV_BUS=kafka
MV_BUS_VALIDATE_ON_READ=true
MV_KAFKA_BROKERS=redpanda:9092
MV_MINIO_ENDPOINT=minio:9000
MV_MINIO_ACCESS_KEY=ci-only-not-a-secret
MV_MINIO_SECRET_KEY=ci-only-not-a-secret-0000
MV_MINIO_USE_SSL=false
MV_WORLD_ID=dark-forest-world
MV_BACKUP_AGE_RECIPIENT=

# ===== gateway =====
MV_GATEWAY_DATA_DIR=/data
MV_GATEWAY_CLIENT_IDS=telegram-bot,ci-harness,mvctl
MV_GATEWAY_ACTOR_KIND_CLIENTS=ci-harness,mvctl
MV_GATEWAY_RATE_ACTIONS_PER_MIN=30
MV_GATEWAY_RATE_ACTIONS_BURST=5
MV_GATEWAY_INPUT_FILTER=noop
MV_GATEWAY_ENCOUNTER_GRACE=10s
MV_GATEWAY_SESSION_IDLE=30m
MV_GATEWAY_TURN_TIMEOUT=60s
MV_GATEWAY_CHARACTER_WAIT=2s
MV_GATEWAY_CHARACTER_DEADLINE=60s
MV_GATEWAY_DELIVERY_LEASE=30s
MV_GATEWAY_DELIVERY_TTL=24h
MV_CORE_URL=http://core:8090

# ===== core =====
MV_CORE_ADDR=:8090
MV_CORE_ADMIN_CLIENTS=operator
MV_MEMORY_URL=
MV_SNAPSHOT_EVERY_FACTS=200
MV_GM_PATH=agent
MV_LAWS_BREACH_PHASE=false

# ===== llm =====
# CI has no GPU and no llama-server: the recorded provider is used by the tests
# themselves, the URL below only has to interpolate.
MV_LLM_PROVIDER=recorded
MV_LLM_URL=http://host.docker.internal:1234
MV_LLM_NUM_CTX=8192
MV_LLM_STORE_PROMPTS=false
MV_LLM_CLOUD_ENABLED=false
MV_LLM_CLOUD_ALLOW_EXTERNAL_PLAYERS=false
MV_LLM_CLOUD_BUDGET_USD_PER_DAY=0
# MV_LLM_API_KEY and MV_ANTHROPIC_API_KEY are absent on purpose. They are empty
# in .env.example, docker-compose.yml falls back to an empty default for them,
# and a key-shaped variable has no business in a file that lives in Git: an
# empty one only teaches gitleaks to read the following line as its value.

# ===== memory (profile memory, T-008) =====
MV_QDRANT_ADDR=qdrant:6334
MV_NEO4J_URI=neo4j://neo4j:7687
MV_NEO4J_USER=neo4j
MV_NEO4J_PASSWORD=ci-only-not-a-secret
MV_EMBED_MODEL=nomic-embed-text

# ===== telegram-bot (profile bot, T-008; docker-compose.bot.yml) =====
# Not shaped like a real bot token on purpose — a realistic dummy would be
# flagged by gitleaks and would teach the wrong habit.
MV_TELEGRAM_BOT_TOKEN=ci-only-not-a-secret
MV_TELEGRAM_ALLOWED_USER_IDS=
MV_TELEGRAM_GATEWAY_URL=http://gateway:8088
MV_TELEGRAM_POLL_TIMEOUT_S=25
MV_TELEGRAM_HEALTH_ADDR=:8089

# ===== legacy (profile legacy, T-008) =====
# The one image pin repeated here, and only because build/versions.env leaves
# CHROMA_IMAGE empty on purpose: which Chroma server tag serves the frozen
# chroma-go client is decided on the stand (D-3), and an empty value must fail
# loudly there. scripts/compose-lint.sh still has to interpolate
# ${CHROMA_IMAGE:?} of docker-compose.legacy.yml, so it gets a placeholder that
# is never pulled — `config` does not resolve a registry.
CHROMA_IMAGE=chromadb/chroma:0.0.0-ci-placeholder
LEGACY_ORACLE_URL=http://host.docker.internal:1234/v1/chat/completions
LEGACY_ORACLE_TIMEOUT_MS=60000
LEGACY_CHROMA_COLLECTION=multiverse_events
